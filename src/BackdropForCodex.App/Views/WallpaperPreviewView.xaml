<UserControl x:Class="BackdropForCodex.App.Views.WallpaperPreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localization="clr-namespace:BackdropForCodex.App.Services.Localization"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:BackdropForCodex.App.Views"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch"
             IsVisibleChanged="WallpaperPreviewView_IsVisibleChanged"
             Unloaded="WallpaperPreviewView_Unloaded">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    <!-- Translucent Codex surfaces. Opacity follows the panel setting; the stroke keeps them legible without media. -->
    <Style x:Key="GlassSurfaceStyle" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource ApplicationBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Opacity" Value="{Binding PanelOpacity}" />
    </Style>

    <!-- Placeholder text lines inside the Codex mock. -->
    <Style x:Key="TextLineStyle" TargetType="Rectangle">
      <Setter Property="Height" Value="6" />
      <Setter Property="RadiusX" Value="3" />
      <Setter Property="RadiusY" Value="3" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Fill" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      <Setter Property="Opacity" Value="0.55" />
    </Style>

    <Style x:Key="FocusGuideLineStyle" TargetType="Border">
      <Setter Property="Background" Value="#E6FFFFFF" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
  </UserControl.Resources>

  <Grid x:Name="PreviewHost"
        MinHeight="220"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Background="Transparent"
        ClipToBounds="False">
    <Viewbox x:Name="PreviewViewbox"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Stretch="Uniform"
             StretchDirection="Both">
      <Border x:Name="PreviewCard"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}"
              ClipToBounds="True">
        <Grid x:Name="PreviewSurface"
              Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}"
              ClipToBounds="True"
              SizeChanged="PreviewSurface_SizeChanged">
          <Grid x:Name="BackdropSource"
                Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}"
                IsHitTestVisible="False">
            <Grid x:Name="MediaViewport"
                  ClipToBounds="True"
                  SizeChanged="MediaViewport_SizeChanged">
              <Canvas ClipToBounds="True"
                      IsHitTestVisible="False">
                <Image x:Name="ImagePreview"
                       Stretch="Fill"
                       Visibility="Collapsed" />
                <MediaElement x:Name="VideoPreview"
                              Stretch="Fill"
                              LoadedBehavior="Manual"
                              UnloadedBehavior="Stop"
                              IsMuted="True"
                              ScrubbingEnabled="True"
                              Visibility="Collapsed"
                              MediaOpened="VideoPreview_MediaOpened"
                              MediaEnded="VideoPreview_MediaEnded"
                              MediaFailed="VideoPreview_MediaFailed" />
              </Canvas>
            </Grid>

            <!-- The theme veil belongs to the sampled backdrop, matching runtime CSS. -->
            <Border x:Name="PreviewThemeOverlay"
                    Background="Black"
                    Visibility="Collapsed"
                    IsHitTestVisible="False" />
          </Grid>

          <Grid x:Name="GlassBlurClipHost"
                IsHitTestVisible="False">
            <Grid.Style>
              <Style TargetType="{x:Type Grid}">
                <Setter Property="Visibility"
                        Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Visibility, ElementName=ImagePreview}"
                               Value="Visible">
                    <Setter Property="Visibility"
                            Value="Visible" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Visibility, ElementName=VideoPreview}"
                               Value="Visible">
                    <Setter Property="Visibility"
                            Value="Visible" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding BlurPx}"
                               Value="0">
                    <Setter Property="Visibility"
                            Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Grid.Style>
            <Rectangle x:Name="GlassBlurVisual">
              <Rectangle.Fill>
                <VisualBrush Visual="{Binding ElementName=BackdropSource}"
                             Stretch="Fill" />
              </Rectangle.Fill>
              <Rectangle.Effect>
                <BlurEffect Radius="{Binding BlurPx}"
                            RenderingBias="Performance" />
              </Rectangle.Effect>
            </Rectangle>
          </Grid>

          <!-- Codex workspace mock: sidebar, thread header, one exchange, composer. -->
          <Grid x:Name="PreviewChromeLayer"
                Margin="14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="200" />
              <ColumnDefinition Width="8" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
              <Border x:Name="LeftGlassSurface"
                      CornerRadius="10"
                      Style="{StaticResource GlassSurfaceStyle}" />
              <Grid Margin="14">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                  <Border x:Name="CodexBadge"
                          Width="16"
                          Height="16"
                          CornerRadius="4"
                          Background="{DynamicResource TextFillColorPrimaryBrush}"
                          Opacity="0.85" />
                  <Rectangle Width="58"
                             Margin="8,0,0,0"
                             VerticalAlignment="Center"
                             Style="{StaticResource TextLineStyle}"
                             Fill="{DynamicResource TextFillColorPrimaryBrush}"
                             Opacity="0.8" />
                </StackPanel>
                <Border Grid.Row="1"
                        Height="28"
                        Margin="0,16,0,0"
                        CornerRadius="7"
                        Background="{DynamicResource ControlFillColorDefaultBrush}">
                  <StackPanel Margin="9,0"
                              Orientation="Horizontal"
                              VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Add16"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <Rectangle Width="50"
                               Margin="7,0,0,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource TextLineStyle}" />
                  </StackPanel>
                </Border>
                <StackPanel Grid.Row="2" Margin="6,22,0,0">
                  <Rectangle Width="40" Height="5" Style="{StaticResource TextLineStyle}" Opacity="0.35" />
                  <Rectangle Width="128" Margin="0,14,0,0" Style="{StaticResource TextLineStyle}" />
                  <Rectangle Width="96" Margin="0,12,0,0" Style="{StaticResource TextLineStyle}" />
                  <Rectangle Width="140" Margin="0,12,0,0" Style="{StaticResource TextLineStyle}" />
                  <Rectangle Width="84" Margin="0,12,0,0" Style="{StaticResource TextLineStyle}" />
                  <Rectangle Width="118" Margin="0,12,0,0" Style="{StaticResource TextLineStyle}" />
                </StackPanel>
                <StackPanel Grid.Row="3" Orientation="Horizontal">
                  <Ellipse Width="18"
                           Height="18"
                           Fill="{DynamicResource ControlStrongFillColorDefaultBrush}" />
                  <Rectangle Width="54"
                             Margin="8,0,0,0"
                             VerticalAlignment="Center"
                             Style="{StaticResource TextLineStyle}" />
                </StackPanel>
              </Grid>
            </Grid>

            <Grid Grid.Column="2">
              <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
                <RowDefinition Height="52" />
              </Grid.RowDefinitions>

              <Border x:Name="TopBarGlassSurface"
                      Grid.Row="0"
                      CornerRadius="10"
                      Style="{StaticResource GlassSurfaceStyle}" />
              <Grid Grid.Row="0" Margin="14,0">
                <Rectangle Width="96"
                           VerticalAlignment="Center"
                           Style="{StaticResource TextLineStyle}"
                           Fill="{DynamicResource TextFillColorPrimaryBrush}"
                           Opacity="0.8" />
                <Border Width="60"
                        Height="18"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        CornerRadius="9"
                        Background="{DynamicResource ControlFillColorDefaultBrush}" />
              </Grid>

              <Grid Grid.Row="1" Margin="40,0,40,0">
                <Grid.RowDefinitions>
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="1"
                      Width="290"
                      Height="44"
                      HorizontalAlignment="Right">
                  <Border x:Name="MessageGlassSurface"
                          CornerRadius="12"
                          Style="{StaticResource GlassSurfaceStyle}" />
                  <StackPanel Margin="14,0" VerticalAlignment="Center">
                    <Rectangle Width="236" Style="{StaticResource TextLineStyle}" />
                    <Rectangle Width="150" Margin="0,9,0,0" Style="{StaticResource TextLineStyle}" />
                  </StackPanel>
                </Grid>
                <StackPanel Grid.Row="2" Margin="4,26,0,0">
                  <Rectangle Width="380" Style="{StaticResource TextLineStyle}" Fill="{DynamicResource TextFillColorPrimaryBrush}" Opacity="0.75" />
                  <Rectangle Width="440" Margin="0,11,0,0" Style="{StaticResource TextLineStyle}" Fill="{DynamicResource TextFillColorPrimaryBrush}" Opacity="0.75" />
                  <Rectangle Width="300" Margin="0,11,0,0" Style="{StaticResource TextLineStyle}" Fill="{DynamicResource TextFillColorPrimaryBrush}" Opacity="0.75" />
                  <Rectangle Width="410" Margin="0,11,0,0" Style="{StaticResource TextLineStyle}" Fill="{DynamicResource TextFillColorPrimaryBrush}" Opacity="0.75" />
                </StackPanel>
              </Grid>

              <Border x:Name="ComposerGlassSurface"
                      Grid.Row="2"
                      Margin="40,0,40,0"
                      CornerRadius="14"
                      Style="{StaticResource GlassSurfaceStyle}" />
              <Grid Grid.Row="2" Margin="56,0,54,0">
                <Rectangle Width="150"
                           VerticalAlignment="Center"
                           Style="{StaticResource TextLineStyle}"
                           Opacity="0.4" />
                <StackPanel HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                  <Ellipse Width="22"
                           Height="22"
                           Margin="0,0,8,0"
                           Stroke="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                           StrokeThickness="1" />
                  <Ellipse Width="24"
                           Height="24"
                           Fill="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>
              </Grid>
            </Grid>
          </Grid>

          <Border x:Name="EmptyPreview"
                  Margin="32"
                  Background="Transparent">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="360">
              <TextBlock Text="{localization:Loc Hint_NoMedia, Fallback='Choose an image or video as the background'}"
                         Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                         FontSize="18"
                         FontWeight="SemiBold"
                         TextAlignment="Center"
                         TextWrapping="Wrap" />
              <TextBlock Margin="0,8,0,0"
                         Text="{localization:Loc Hint_DropMedia, Fallback='or drop one here'}"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                         TextAlignment="Center" />
            </StackPanel>
          </Border>

          <Border x:Name="UnavailablePreview"
                  Margin="32"
                  Background="Transparent"
                  Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="380">
              <TextBlock Text="{localization:Loc Preview_Unavailable_Title, Fallback='Preview unavailable'}"
                         Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                         FontSize="18"
                         FontWeight="SemiBold"
                         TextAlignment="Center"
                         TextWrapping="Wrap" />
              <TextBlock Margin="0,8,0,0"
                         Text="{localization:Loc Preview_Unavailable_Message, Fallback='This source cannot be previewed here. It can still be applied.'}"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                         TextAlignment="Center"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <!-- Rule-of-thirds guide. Hidden until the crop focus is adjustable and the pointer is over the preview. -->
          <Grid x:Name="FocusGuideOverlay"
                IsHitTestVisible="False"
                Visibility="{Binding HasSelectedMedia, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.Style>
              <Style TargetType="Grid">
                <Setter Property="Opacity" Value="0" />
                <Style.Triggers>
                  <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                      <Condition Binding="{Binding CanAdjustFocus}" Value="True" />
                      <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type views:WallpaperPreviewView}}}"
                                 Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Opacity" Value="0.45" />
                  </MultiDataTrigger>
                  <DataTrigger Binding="{Binding IsWorkbenchHighContrast, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                               Value="True">
                    <Setter Property="Opacity" Value="1" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="*" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border x:Name="FocusGuideVerticalLeft"
                    Grid.Column="0"
                    Grid.RowSpan="3"
                    Width="1"
                    HorizontalAlignment="Right"
                    Style="{StaticResource FocusGuideLineStyle}" />
            <Border x:Name="FocusGuideVerticalRight"
                    Grid.Column="1"
                    Grid.RowSpan="3"
                    Width="1"
                    HorizontalAlignment="Right"
                    Style="{StaticResource FocusGuideLineStyle}" />
            <Border x:Name="FocusGuideHorizontalTop"
                    Grid.Row="0"
                    Grid.ColumnSpan="3"
                    Height="1"
                    VerticalAlignment="Bottom"
                    Style="{StaticResource FocusGuideLineStyle}" />
            <Border x:Name="FocusGuideHorizontalBottom"
                    Grid.Row="1"
                    Grid.ColumnSpan="3"
                    Height="1"
                    VerticalAlignment="Bottom"
                    Style="{StaticResource FocusGuideLineStyle}" />
          </Grid>

          <Border x:Name="FocusInteractionSurface"
                  Background="#01FFFFFF"
                  IsEnabled="{Binding CanAdjustFocus, RelativeSource={RelativeSource AncestorType={x:Type views:WallpaperPreviewView}}}"
                  IsHitTestVisible="{Binding CanAdjustFocus, RelativeSource={RelativeSource AncestorType={x:Type views:WallpaperPreviewView}}}"
                  Focusable="{Binding CanAdjustFocus, RelativeSource={RelativeSource AncestorType={x:Type views:WallpaperPreviewView}}}"
                  ClipToBounds="True"
                  Cursor="SizeAll"
                  AutomationProperties.Name="{localization:Loc Focus_AutomationName, Fallback='Wallpaper crop focus'}"
                  AutomationProperties.HelpText="{localization:Loc Focus_AutomationHelp, Fallback='Drag to set the crop focus. Arrow keys move one percent; hold Shift to move ten percent.'}"
                  AutomationProperties.ItemStatus="{Binding FocusLabel}"
                  MouseLeftButtonDown="FocusInteractionSurface_MouseLeftButtonDown"
                  MouseMove="FocusInteractionSurface_MouseMove"
                  MouseLeftButtonUp="FocusInteractionSurface_MouseLeftButtonUp"
                  LostMouseCapture="FocusInteractionSurface_LostMouseCapture"
                  KeyDown="FocusInteractionSurface_KeyDown">
            <Canvas IsHitTestVisible="False">
              <Grid x:Name="FocusIndicator"
                    Width="40"
                    Height="40"
                    SnapsToDevicePixels="True"
                    UseLayoutRounding="True"
                    Opacity="0">
                <Ellipse Width="38"
                         Height="38"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Fill="#260B1018"
                         Stroke="{DynamicResource AccentFillColorDefaultBrush}"
                         StrokeThickness="2" />
                <Line X1="20" Y1="6" X2="20" Y2="34"
                      Stroke="#F7FFFFFF"
                      StrokeThickness="1.25" />
                <Line X1="6" Y1="20" X2="34" Y2="20"
                      Stroke="#F7FFFFFF"
                      StrokeThickness="1.25" />
                <Ellipse Width="8"
                         Height="8"
                         Fill="{DynamicResource AccentFillColorDefaultBrush}"
                         Stroke="White"
                         StrokeThickness="1.5"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
                <Ellipse Width="2"
                         Height="2"
                         Fill="White"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
              </Grid>
            </Canvas>
          </Border>

          <Border x:Name="MediaNamePill"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Bottom"
                  Margin="16"
                  Padding="10,6"
                  CornerRadius="7"
                  BorderThickness="0"
                  Background="#B020242B"
                  Visibility="{Binding HasSelectedMedia, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock MaxWidth="300"
                       VerticalAlignment="Center"
                       Foreground="White"
                       Text="{Binding SelectedMediaName}"
                       TextTrimming="CharacterEllipsis" />
          </Border>

          <Border x:Name="StaticPreviewPill"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  Margin="16"
                  Padding="10,6"
                  CornerRadius="7"
                  BorderThickness="0"
                  Background="#D911161B"
                  Visibility="Collapsed"
                  IsHitTestVisible="False"
                  AutomationProperties.Name="{localization:Loc Source_StaticPreview, Fallback='Static preview'}"
                  AutomationProperties.HelpText="{localization:Loc Source_StaticPreviewHint, Fallback='This is the project thumbnail, not the live Wallpaper Engine output.'}">
            <TextBlock Text="{localization:Loc Source_StaticPreview, Fallback='Static preview'}"
                       Foreground="White"
                       VerticalAlignment="Center" />
          </Border>

          <Border x:Name="DropOverlay"
                  Visibility="Collapsed"
                  Margin="10"
                  CornerRadius="8"
                  BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                  BorderThickness="2"
                  Background="#CC16191E"
                  IsHitTestVisible="False">
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Text="{localization:Loc Hint_DropTarget, Fallback='Drop to use it here'}"
                       Foreground="White"
                       FontSize="17"
                       FontWeight="SemiBold" />
          </Border>
        </Grid>
      </Border>
    </Viewbox>
  </Grid>
</UserControl>
