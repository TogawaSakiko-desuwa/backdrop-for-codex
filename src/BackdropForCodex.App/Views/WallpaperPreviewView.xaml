<UserControl x:Class="BackdropForCodex.App.Views.WallpaperPreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localization="clr-namespace:BackdropForCodex.App.Services.Localization"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:BackdropForCodex.App.Views"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch"
             IsVisibleChanged="WallpaperPreviewView_IsVisibleChanged"
             Unloaded="WallpaperPreviewView_Unloaded">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
  </UserControl.Resources>

  <Grid x:Name="PreviewHost"
        MinHeight="220"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Background="Transparent"
        ClipToBounds="False">
    <Viewbox x:Name="PreviewViewbox"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Stretch="Uniform"
             StretchDirection="Both">
      <Border x:Name="PreviewCard"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              CornerRadius="8"
              Background="#171A20"
              ClipToBounds="True">
        <Grid x:Name="PreviewSurface"
              Background="#171A20"
              ClipToBounds="True"
              SizeChanged="PreviewSurface_SizeChanged">
          <Grid x:Name="BackdropSource"
                Background="#171A20"
                IsHitTestVisible="False">
            <Grid x:Name="MediaViewport"
                  ClipToBounds="True"
                  SizeChanged="MediaViewport_SizeChanged">
              <Canvas ClipToBounds="True"
                      IsHitTestVisible="False">
                <Image x:Name="ImagePreview"
                       Stretch="Fill"
                       Visibility="Collapsed" />
                <MediaElement x:Name="VideoPreview"
                              Stretch="Fill"
                              LoadedBehavior="Manual"
                              UnloadedBehavior="Stop"
                              IsMuted="True"
                              ScrubbingEnabled="True"
                              Visibility="Collapsed"
                              MediaOpened="VideoPreview_MediaOpened"
                              MediaEnded="VideoPreview_MediaEnded"
                              MediaFailed="VideoPreview_MediaFailed" />
              </Canvas>
            </Grid>

            <!-- The theme veil belongs to the sampled backdrop, matching runtime CSS. -->
            <Border x:Name="PreviewThemeOverlay"
                    Background="Black"
                    Visibility="Collapsed"
                    IsHitTestVisible="False" />
          </Grid>

          <Grid x:Name="GlassBlurClipHost"
                IsHitTestVisible="False">
            <Grid.Style>
              <Style TargetType="{x:Type Grid}">
                <Setter Property="Visibility"
                        Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Visibility, ElementName=ImagePreview}"
                               Value="Visible">
                    <Setter Property="Visibility"
                            Value="Visible" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Visibility, ElementName=VideoPreview}"
                               Value="Visible">
                    <Setter Property="Visibility"
                            Value="Visible" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding BlurPx}"
                               Value="0">
                    <Setter Property="Visibility"
                            Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Grid.Style>
            <Rectangle x:Name="GlassBlurVisual">
              <Rectangle.Fill>
                <VisualBrush Visual="{Binding ElementName=BackdropSource}"
                             Stretch="Fill" />
              </Rectangle.Fill>
              <Rectangle.Effect>
                <BlurEffect Radius="{Binding BlurPx}"
                            RenderingBias="Performance" />
              </Rectangle.Effect>
            </Rectangle>
          </Grid>

          <Border x:Name="EmptyPreview"
                  Margin="32"
                  Background="Transparent">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="340">
              <Border Width="64"
                      Height="64"
                      Margin="0,0,0,16"
                      CornerRadius="18"
                      Background="#242B36">
                <ui:SymbolIcon Symbol="Image24"
                               FontSize="30"
                               Foreground="#A9C7FF"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="{localization:Loc Hint_NoMedia, Fallback='Choose media to start designing your wallpaper.'}"
                         Foreground="#F5F7FA"
                         FontSize="18"
                         FontWeight="SemiBold"
                         TextAlignment="Center"
                         TextWrapping="Wrap" />
              <TextBlock Margin="0,8,0,0"
                         Text="{localization:Loc Hint_DropMedia, Fallback='Drop one image or video here'}"
                         Foreground="#AAB2BF"
                         TextAlignment="Center" />
            </StackPanel>
          </Border>

          <!-- Keep the preview compact, but preserve Codex's left navigation,
               central task surface, and right context panel. -->
          <Grid x:Name="PreviewChromeLayer"
                Margin="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.2*" MinWidth="88" />
              <ColumnDefinition Width="8" />
              <ColumnDefinition Width="3.5*" MinWidth="150" />
              <ColumnDefinition Width="8" />
              <ColumnDefinition Width="1.35*" MinWidth="96" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
              <Border x:Name="LeftGlassSurface"
                      CornerRadius="12"
                      Background="{DynamicResource ApplicationBackgroundBrush}"
                      Opacity="{Binding PanelOpacity}" />
              <Grid Margin="12">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="12" />
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                  <Border x:Name="CodexBadge"
                          Width="18" Height="18" CornerRadius="5"
                          Background="{DynamicResource AccentFillColorDefaultBrush}">
                    <TextBlock Text="C"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="White"
                               FontSize="10"
                               FontWeight="Bold" />
                  </Border>
                  <TextBlock Margin="7,0,0,0"
                             VerticalAlignment="Center"
                             Text="Codex"
                             FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Row="2">
                  <Border Height="26" CornerRadius="7"
                          Background="{DynamicResource ControlFillColorDefaultBrush}">
                    <StackPanel Margin="8,0" Orientation="Horizontal"
                                VerticalAlignment="Center">
                      <ui:SymbolIcon Symbol="Add16" FontSize="11" />
                      <Rectangle Width="44" Height="5" Margin="6,0,0,0"
                                 RadiusX="2.5" RadiusY="2.5"
                                 Fill="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                  </Border>
                  <Rectangle Height="5" Margin="8,12,18,0"
                             RadiusX="2.5" RadiusY="2.5"
                             Fill="{DynamicResource TextFillColorSecondaryBrush}"
                             Opacity="0.72" />
                  <Rectangle Height="5" Margin="8,10,10,0"
                             RadiusX="2.5" RadiusY="2.5"
                             Fill="{DynamicResource TextFillColorSecondaryBrush}"
                             Opacity="0.58" />
                  <Rectangle Height="5" Margin="8,10,24,0"
                             RadiusX="2.5" RadiusY="2.5"
                             Fill="{DynamicResource TextFillColorSecondaryBrush}"
                             Opacity="0.45" />
                </StackPanel>
                <Ellipse Grid.Row="3" Width="18" Height="18"
                         HorizontalAlignment="Left"
                         Fill="{DynamicResource AccentFillColorSecondaryBrush}" />
              </Grid>
            </Grid>

            <Grid Grid.Column="2">
              <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="*" />
                <RowDefinition Height="36" />
              </Grid.RowDefinitions>
              <Border x:Name="TopBarGlassSurface"
                      Grid.Row="0"
                      CornerRadius="10"
                      Background="{DynamicResource ApplicationBackgroundBrush}"
                      Opacity="{Binding PanelOpacity}" />
              <Grid Grid.Row="0" Margin="11,0">
                <Rectangle Width="82" Height="6"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           RadiusX="3" RadiusY="3"
                           Fill="{DynamicResource TextFillColorPrimaryBrush}"
                           Opacity="0.8" />
                <StackPanel HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                  <Ellipse Width="6" Height="6"
                           Fill="{DynamicResource AccentFillColorDefaultBrush}" />
                  <Rectangle Width="28" Height="5" Margin="6,0,0,0"
                             RadiusX="2.5" RadiusY="2.5"
                             Fill="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
              </Grid>

              <StackPanel Grid.Row="1"
                          Margin="14,12"
                          VerticalAlignment="Center">
                <Border Width="72"
                        Height="24"
                        HorizontalAlignment="Right"
                        CornerRadius="8"
                        Background="{DynamicResource ControlFillColorDefaultBrush}" />
                <Border x:Name="MessageGlassSurface"
                        Height="42"
                        Margin="0,9,26,0"
                        CornerRadius="9"
                        Background="{DynamicResource ApplicationBackgroundBrush}"
                        Opacity="{Binding PanelOpacity}" />
                <Border Width="96"
                        Height="24"
                        Margin="0,9,0,0"
                        HorizontalAlignment="Left"
                        CornerRadius="8"
                        Background="{DynamicResource ControlFillColorDefaultBrush}" />
              </StackPanel>

              <Border x:Name="ComposerGlassSurface"
                      Grid.Row="2"
                      CornerRadius="10"
                      Background="{DynamicResource ApplicationBackgroundBrush}"
                      Opacity="{Binding PanelOpacity}" />
              <Grid Grid.Row="2" Margin="11,0">
                <Rectangle Height="5"
                           Margin="0,0,42,0"
                           VerticalAlignment="Center"
                           RadiusX="2.5" RadiusY="2.5"
                           Fill="{DynamicResource TextFillColorSecondaryBrush}"
                           Opacity="0.55" />
                <Border Width="22" Height="22"
                        HorizontalAlignment="Right"
                        CornerRadius="7"
                        Background="{DynamicResource AccentFillColorDefaultBrush}">
                  <ui:SymbolIcon Symbol="Send24"
                                 FontSize="11"
                                 Foreground="White" />
                </Border>
              </Grid>
            </Grid>

            <Grid Grid.Column="4">
              <Border x:Name="RightGlassSurface"
                      CornerRadius="12"
                      Background="{DynamicResource ApplicationBackgroundBrush}"
                      Opacity="{Binding PanelOpacity}" />
              <StackPanel Margin="12">
                <TextBlock Text="{localization:Loc Section_Preview, Fallback=Preview}"
                           FontWeight="SemiBold" />
                <Rectangle Height="5" Margin="0,12,10,0"
                           RadiusX="2.5" RadiusY="2.5"
                           Fill="{DynamicResource TextFillColorSecondaryBrush}"
                           Opacity="0.72" />
                <Rectangle Height="5" Margin="0,10,22,0"
                           RadiusX="2.5" RadiusY="2.5"
                           Fill="{DynamicResource TextFillColorSecondaryBrush}"
                           Opacity="0.55" />
                <Border Height="38" Margin="0,14,0,0"
                        CornerRadius="8"
                        Background="{DynamicResource ControlFillColorDefaultBrush}" />
                <Border Height="24" Margin="0,8,0,0"
                        CornerRadius="8"
                        Background="{DynamicResource ControlFillColorDefaultBrush}" />
              </StackPanel>
            </Grid>
          </Grid>

          <Border x:Name="FocusInteractionSurface"
                  Background="#01FFFFFF"
                  IsEnabled="{Binding CanAdjustFocus, RelativeSource={RelativeSource AncestorType={x:Type views:WallpaperPreviewView}}}"
                  IsHitTestVisible="{Binding CanAdjustFocus, RelativeSource={RelativeSource AncestorType={x:Type views:WallpaperPreviewView}}}"
                  Focusable="{Binding CanAdjustFocus, RelativeSource={RelativeSource AncestorType={x:Type views:WallpaperPreviewView}}}"
                  ClipToBounds="True"
                  Cursor="SizeAll"
                  ToolTip="{localization:Loc Focus_AutomationHelp, Fallback='Drag to set the crop focus. Arrow keys move one percent; hold Shift to move ten percent.'}"
                  AutomationProperties.Name="{localization:Loc Focus_AutomationName, Fallback='Wallpaper crop focus'}"
                  AutomationProperties.HelpText="{localization:Loc Focus_AutomationHelp, Fallback='Drag to set the crop focus. Arrow keys move one percent; hold Shift to move ten percent.'}"
                  AutomationProperties.ItemStatus="{Binding FocusLabel}"
                  MouseLeftButtonDown="FocusInteractionSurface_MouseLeftButtonDown"
                  MouseMove="FocusInteractionSurface_MouseMove"
                  MouseLeftButtonUp="FocusInteractionSurface_MouseLeftButtonUp"
                  LostMouseCapture="FocusInteractionSurface_LostMouseCapture"
                  KeyDown="FocusInteractionSurface_KeyDown">
            <Canvas IsHitTestVisible="False">
              <Grid x:Name="FocusIndicator"
                    Width="34"
                    Height="34"
                    Opacity="0">
                <Ellipse Fill="#66000000"
                         Stroke="White"
                         StrokeThickness="2" />
                <Line X1="17" Y1="5" X2="17" Y2="29"
                      Stroke="White"
                      StrokeThickness="1" />
                <Line X1="5" Y1="17" X2="29" Y2="17"
                      Stroke="White"
                      StrokeThickness="1" />
                <Ellipse Width="5"
                         Height="5"
                         Fill="White"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
              </Grid>
            </Canvas>
          </Border>

          <Border HorizontalAlignment="Left"
                  VerticalAlignment="Bottom"
                  Margin="16"
                  Padding="10,6"
                  CornerRadius="8"
                  Background="#B020242B"
                  Visibility="{Binding HasSelectedMedia, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="Image24" Foreground="White" />
              <TextBlock Margin="7,0,0,0"
                         MaxWidth="280"
                         VerticalAlignment="Center"
                         Foreground="White"
                         FontWeight="SemiBold"
                         Text="{Binding SelectedMediaName}"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Border>

          <Border x:Name="DropOverlay"
                  Visibility="Collapsed"
                  Margin="10"
                  CornerRadius="14"
                  BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                  BorderThickness="2"
                  Background="#D9192636"
                  IsHitTestVisible="False">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
              <ui:SymbolIcon Symbol="ArrowUpload24"
                             FontSize="36"
                             Foreground="#DCEAFF" />
              <TextBlock Margin="0,12,0,0"
                         Text="{localization:Loc Hint_DropMedia, Fallback='Drop one image or video here'}"
                         Foreground="White"
                         FontSize="17"
                         FontWeight="SemiBold" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>
    </Viewbox>
  </Grid>
</UserControl>
