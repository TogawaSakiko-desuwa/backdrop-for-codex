<UserControl x:Class="BackdropForCodex.App.Views.SettingsDialogContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localization="clr-namespace:BackdropForCodex.App.Services.Localization"
             xmlns:preferences="clr-namespace:BackdropForCodex.App.Services.Preferences"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             MinWidth="520"
             MaxWidth="600">
  <Grid>
    <TabControl>
      <TabItem Header="{localization:Loc Section_Appearance, Fallback=Appearance}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="4,18,4,4">
            <ui:Card>
              <StackPanel Margin="16">
                <TextBlock Style="{StaticResource SectionHeadingStyle}"
                           Text="{localization:Loc Label_Theme, Fallback='App theme'}" />
                <TextBlock Margin="0,4,0,12"
                           Style="{StaticResource CaptionTextStyle}"
                           Text="{localization:Loc Settings_ThemeDescription, Fallback='Follow Windows by default, including high contrast.'}" />
                <TextBlock x:Name="ProtectedPreferencesNotice"
                           Margin="0,0,0,12"
                           Style="{StaticResource CaptionTextStyle}"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />
                <ComboBox x:Name="ThemeComboBox"
                          AutomationProperties.Name="{localization:Loc Label_Theme, Fallback='App theme'}"
                          SelectedValuePath="Tag"
                          SelectionChanged="ThemeComboBox_SelectionChanged">
                  <ComboBoxItem Content="{localization:Loc Theme_System, Fallback='Use system setting'}"
                                Tag="{x:Static preferences:ThemeMode.System}" />
                  <ComboBoxItem Content="{localization:Loc Theme_Light, Fallback=Light}"
                                Tag="{x:Static preferences:ThemeMode.Light}" />
                  <ComboBoxItem Content="{localization:Loc Theme_Dark, Fallback=Dark}"
                                Tag="{x:Static preferences:ThemeMode.Dark}" />
                </ComboBox>
              </StackPanel>
            </ui:Card>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{localization:Loc Section_SafetyPrivacy, Fallback='Safety &amp; privacy'}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="4,18,4,4">
            <ui:Card Margin="0,0,0,12">
              <StackPanel Margin="16">
                <TextBlock Style="{StaticResource SectionHeadingStyle}"
                           Text="{localization:Loc Settings_RiskTitle, Fallback='Local Codex debugging'}" />
                <TextBlock Margin="0,4,0,8"
                           Style="{StaticResource CaptionTextStyle}"
                           Text="{localization:Loc Settings_RiskDescription, Fallback='Review or revoke the local debugging acknowledgement.'}" />
                <TextBlock x:Name="RiskStateText"
                           Margin="0,4,0,12"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <ui:Button x:Name="RevokeRiskButton"
                           HorizontalAlignment="Left"
                           Content="{localization:Loc Action_RevokeRisk, Fallback='Revoke acknowledgement'}"
                           Click="RevokeRiskButton_Click" />
              </StackPanel>
            </ui:Card>
            <ui:Card x:Name="RecoveryCard" Margin="0,12,0,0">
              <StackPanel Margin="16">
                <TextBlock Style="{StaticResource SectionHeadingStyle}"
                           Text="{localization:Loc Settings_RecoveryTitle, Fallback='Settings recovery'}" />
                <TextBlock Margin="0,5,0,12"
                           Style="{StaticResource CaptionTextStyle}"
                           Text="{localization:Loc Settings_RecoveryDescription, Fallback='A protected backup from an earlier version is available. Restoring it replaces the current settings; the original backup remains unchanged.'}" />
                <ui:Button x:Name="RestoreBackupButton"
                           HorizontalAlignment="Left"
                           Content="{localization:Loc Action_RestoreBackup, Fallback='Restore earlier backup'}"
                           Click="RestoreBackupButton_Click" />
              </StackPanel>
            </ui:Card>
            <ui:Card>
              <StackPanel Margin="16">
                <TextBlock Style="{StaticResource SectionHeadingStyle}"
                           Text="{localization:Loc Section_Privacy, Fallback='Privacy'}" />
                <TextBlock Margin="0,4,0,0"
                           Style="{StaticResource CaptionTextStyle}"
                     Text="{localization:Loc Settings_PrivacyDescription, Fallback='Backdrop uses no media HTTP server. Local files stay on this device. Scene and Web projects run only inside Wallpaper Engine and may play sound. Backdrop does not enumerate, mute, or change Wallpaper Engine audio sessions, and sends no audio into Codex. Third-party Web wallpapers may access the network. Backdrop sends only captured pixels into Codex and never exposes Codex content to the wallpaper.'}" />
              </StackPanel>
            </ui:Card>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{localization:Loc Section_About, Fallback=About}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="4,18,4,4">
            <ui:Card Margin="0,0,0,12">
              <Grid Margin="16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="56" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Width="44" Height="44"
                       Source="{StaticResource AppIconImage}" />
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                  <TextBlock Style="{StaticResource SectionHeadingStyle}"
                             Text="{localization:Loc App_Title, Fallback='Backdrop for Codex'}" />
                  <TextBlock x:Name="VersionText"
                             Margin="0,3,0,0"
                             Style="{StaticResource CaptionTextStyle}" />
                  <TextBlock Margin="0,6,0,0"
                             Style="{StaticResource CaptionTextStyle}"
                             Text="{localization:Loc About_NonAffiliation, Fallback='An independent project. Not affiliated with or endorsed by OpenAI.'}" />
                </StackPanel>
              </Grid>
            </ui:Card>
            <ui:Card Margin="0,0,0,12">
              <StackPanel Margin="16">
                <TextBlock Style="{StaticResource SectionHeadingStyle}"
                           Text="{localization:Loc Diagnostics_Title, Fallback='Diagnostic report'}" />
                <TextBlock Margin="0,5,0,12"
                           Style="{StaticResource CaptionTextStyle}"
                           Text="{localization:Loc Diagnostics_Description, Fallback='Create a local report to help investigate compatibility and wallpaper connection problems.'}" />
                <ui:Button HorizontalAlignment="Left"
                           Content="{localization:Loc Diagnostics_Export, Fallback='Export diagnostic report'}"
                           Click="DiagnosticExportButton_Click" />
              </StackPanel>
            </ui:Card>
            <ui:Card Margin="0,0,0,12">
              <StackPanel Margin="16">
                <TextBlock Style="{StaticResource SectionHeadingStyle}"
                           Text="{localization:Loc Settings_Licenses, Fallback='Open-source licenses'}" />
                <TextBlock Margin="0,8,0,0" Text="WPF-UI 4.3.0 — MIT" />
                <TextBlock Margin="0,4,0,0" Text="WPF-UI.Tray 4.3.0 — MIT" />
                <TextBlock Margin="0,4,0,0" Text="CommunityToolkit.Mvvm 8.4.2 — MIT" />
                <TextBlock Margin="0,4,0,0" Text="Microsoft.Extensions.Logging.Abstractions 8.0.0 — MIT" />
                <TextBlock Margin="0,4,0,0" Text="PuppeteerSharp 25.3.4 — MIT" />
                <TextBlock Margin="0,8,0,0"
                           Style="{StaticResource CaptionTextStyle}"
                           Text="{localization:Loc Settings_ThirdPartyNotices, Fallback='Full notices are included in THIRD_PARTY_NOTICES.md.'}" />
              </StackPanel>
            </ui:Card>
            <ui:Card>
              <StackPanel Margin="16">
                <TextBlock Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                           FontWeight="SemiBold"
                           Text="{localization:Loc Section_DangerZone, Fallback='Danger zone'}" />
                <TextBlock Margin="0,5,0,12"
                           Style="{StaticResource CaptionTextStyle}"
                           Text="{localization:Loc Settings_ResetSummary, Fallback='Restore the official background and permanently delete all app settings, recent media, acknowledgements, preferences, shortcuts, and protected backups.'}" />
                <ui:Button HorizontalAlignment="Left"
                           Appearance="Danger"
                           Content="{localization:Loc Action_ResetApp, Fallback='Reset app'}"
                           Click="ResetButton_Click" />
              </StackPanel>
            </ui:Card>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
