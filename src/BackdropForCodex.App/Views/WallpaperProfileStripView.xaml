<UserControl x:Class="BackdropForCodex.App.Views.WallpaperProfileStripView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:BackdropForCodex.App.Converters"
             xmlns:localization="clr-namespace:BackdropForCodex.App.Services.Localization"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:BackdropForCodex.App.Views"
             Focusable="False">
  <UserControl.Resources>
    <converters:MediaThumbnailConverter x:Key="ProfileThumbnailConverter" />
    <converters:ProfileCardTrackWidthConverter x:Key="ProfileCardTrackWidthConverter" />

    <ContextMenu x:Key="ProfileActionsMenu"
                 x:Shared="False"
                 DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
      <MenuItem Header="{localization:Loc Action_DuplicateProfile, Fallback=Duplicate}"
                Command="{Binding PlacementTarget.Tag.DuplicateProfileCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                CommandParameter="{Binding}" />
      <MenuItem Header="{localization:Loc Action_RenameProfile, Fallback=Rename}"
                Command="{Binding PlacementTarget.Tag.RenameProfileCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                CommandParameter="{Binding}" />
      <Separator />
      <MenuItem Header="{localization:Loc Action_DeleteProfile, Fallback=Delete}"
                Command="{Binding PlacementTarget.Tag.DeleteProfileCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                CommandParameter="{Binding}" />
    </ContextMenu>

    <Style x:Key="ProfileCardItemStyle" TargetType="ListBoxItem">
      <Setter Property="Margin" Value="0,0,10,0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
      <Setter Property="Tag"
              Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type views:WallpaperProfileStripView}}}" />
      <Setter Property="ContextMenu" Value="{StaticResource ProfileActionsMenu}" />
      <EventSetter Event="ContextMenuOpening" Handler="ProfileItem_ContextMenuOpening" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="CardBorder"
                    Width="194"
                    Height="84"
                    Padding="9"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="9"
                    SnapsToDevicePixels="True">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="CardBorder"
                        Property="Background"
                        Value="{DynamicResource ControlFillColorSecondaryBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="CardBorder"
                        Property="BorderBrush"
                        Value="{DynamicResource AccentFillColorDefaultBrush}" />
                <Setter TargetName="CardBorder" Property="BorderThickness" Value="2" />
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="CardBorder"
                        Property="BorderBrush"
                        Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                <Setter TargetName="CardBorder" Property="BorderThickness" Value="2" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="CardBorder" Property="Opacity" Value="0.55" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <StackPanel>
    <Grid Margin="0,0,0,8">
      <StackPanel>
        <TextBlock Style="{StaticResource SectionHeadingStyle}"
                   Text="{localization:Loc Section_Profiles, Fallback='Wallpaper profiles'}" />
        <TextBlock Margin="0,2,0,0"
                   Style="{StaticResource CaptionTextStyle}"
                   Text="{localization:Loc Hint_ProfileStrip, Fallback='Choose the draft profile to preview and edit.'}" />
      </StackPanel>
    </Grid>

    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Disabled"
                  CanContentScroll="False"
                  PanningMode="HorizontalOnly"
                  Focusable="False">
      <StackPanel Orientation="Horizontal">
        <ListBox x:Name="ProfileList"
                 Width="{Binding ItemsSource.Count, ElementName=Root, Converter={StaticResource ProfileCardTrackWidthConverter}}"
                 ItemsSource="{Binding ItemsSource, ElementName=Root}"
                 SelectedItem="{Binding SelectedItem, ElementName=Root, Mode=TwoWay}"
                 IsEnabled="{Binding CanEditProfiles, ElementName=Root}"
                 ItemContainerStyle="{StaticResource ProfileCardItemStyle}"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="0"
                 ScrollViewer.CanContentScroll="False"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="False"
                 SelectionMode="Single"
                 KeyboardNavigation.DirectionalNavigation="Contained"
                 KeyboardNavigation.TabNavigation="Once"
                 AutomationProperties.Name="{localization:Loc Section_Profiles, Fallback='Wallpaper profiles'}"
                 AutomationProperties.HelpText="{localization:Loc Hint_ProfileStrip, Fallback='Choose the draft profile to preview and edit.'}"
                 SelectionChanged="ProfileList_SelectionChanged">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="62" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="24" />
                </Grid.ColumnDefinitions>

                <Border Width="58"
                        Height="62"
                        CornerRadius="7"
                        Background="{DynamicResource AccentFillColorSecondaryBrush}"
                        ClipToBounds="True">
                  <Grid>
                    <Image Source="{Binding PreviewPath, Converter={StaticResource ProfileThumbnailConverter}}"
                           Stretch="UniformToFill">
                      <Image.Style>
                        <Style TargetType="Image">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsImagePreviewAvailable}" Value="True">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Image.Style>
                    </Image>

                    <ui:SymbolIcon Symbol="Image24"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">
                      <ui:SymbolIcon.Style>
                        <Style TargetType="ui:SymbolIcon">
                          <Setter Property="Visibility" Value="Visible" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsImagePreviewAvailable}" Value="True">
                              <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsVideo}" Value="True">
                              <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsMissing}" Value="True">
                              <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>

                    <TextBlock Text="▶"
                               FontSize="22"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsVideo}" Value="True">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="!"
                               FontSize="22"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMissing}" Value="True">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Grid>
                </Border>

                <StackPanel Grid.Column="1"
                            Margin="8,2,5,0"
                            ToolTip="{Binding MediaDisplayName}">
                  <TextBlock Text="{Binding Name}"
                             FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Margin="0,3,0,0"
                             Text="{Binding Subtitle}"
                             FontSize="11"
                             Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Margin="0,2,0,0"
                             Text="{Binding MediaDisplayName}"
                             FontSize="10"
                             Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <ui:Button Grid.Column="2"
                           Width="24"
                           Height="24"
                           Padding="0"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Top"
                           Appearance="Transparent"
                           Content="⋯"
                           FontSize="16"
                           Tag="{Binding RelativeSource={RelativeSource AncestorType={x:Type views:WallpaperProfileStripView}}}"
                           ContextMenu="{StaticResource ProfileActionsMenu}"
                           ToolTip="{Binding ActionsAutomationName}"
                           AutomationProperties.Name="{Binding ActionsAutomationName}"
                           Click="ProfileActions_Click" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <ui:Button Width="126"
                   Height="84"
                   Margin="0,0,2,0"
                   Appearance="Secondary"
                   Command="{Binding CreateProfileCommand, ElementName=Root}"
                   IsEnabled="{Binding CanEditProfiles, ElementName=Root}"
                   AutomationProperties.Name="{localization:Loc Action_NewProfile, Fallback='New profile'}">
          <StackPanel HorizontalAlignment="Center">
            <ui:SymbolIcon Symbol="Add16"
                           HorizontalAlignment="Center"
                           FontSize="18" />
            <TextBlock Margin="0,6,0,0"
                       Text="{localization:Loc Action_NewProfile, Fallback='New profile'}"
                       TextAlignment="Center" />
          </StackPanel>
        </ui:Button>
      </StackPanel>
    </ScrollViewer>
  </StackPanel>
</UserControl>
