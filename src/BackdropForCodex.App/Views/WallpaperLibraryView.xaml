<UserControl x:Class="BackdropForCodex.App.Views.WallpaperLibraryView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:BackdropForCodex.App.Converters"
             xmlns:localization="clr-namespace:BackdropForCodex.App.Services.Localization"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:BackdropForCodex.App.Views"
             Width="224"
             MinWidth="56"
             Focusable="False"
             Style="{DynamicResource WorkbenchRootStyle}">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/BackdropForCodex;component/Themes/WorkbenchTheme.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <converters:MediaThumbnailConverter x:Key="LibraryThumbnailConverter" />

      <ContextMenu x:Key="LibraryProfileActionsMenu"
                   x:Shared="False"
                   DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
        <MenuItem Header="{localization:Loc Action_DuplicateProfile, Fallback=Duplicate}"
                  Command="{Binding PlacementTarget.Tag.DuplicateProfileCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                  CommandParameter="{Binding}" />
        <MenuItem Header="{localization:Loc Action_RenameProfile, Fallback=Rename}"
                  Command="{Binding PlacementTarget.Tag.RenameProfileCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                  CommandParameter="{Binding}" />
        <Separator />
        <MenuItem Header="{localization:Loc Action_DeleteProfile, Fallback=Delete}"
                  Command="{Binding PlacementTarget.Tag.DeleteProfileCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                  CommandParameter="{Binding}" />
      </ContextMenu>

      <Style x:Key="LibraryListBoxItemStyle" TargetType="ListBoxItem">
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Margin" Value="4,2" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource WorkbenchFocusVisualStyle}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ListBoxItem">
              <Border x:Name="ItemSurface"
                      Padding="{TemplateBinding Padding}"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="{DynamicResource WorkbenchRadius8}"
                      SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="ItemSurface"
                          Property="Background"
                          Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="ItemSurface"
                          Property="Background"
                          Value="{DynamicResource AccentFillColorSecondaryBrush}" />
                  <Setter TargetName="ItemSurface"
                          Property="BorderBrush"
                          Value="{DynamicResource AccentFillColorDefaultBrush}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                  <Setter TargetName="ItemSurface"
                          Property="BorderBrush"
                          Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                  <Setter TargetName="ItemSurface" Property="BorderThickness" Value="2" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="ItemSurface" Property="Opacity" Value="0.55" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="ProfileLibraryListBoxItemStyle"
             TargetType="ListBoxItem"
             BasedOn="{StaticResource LibraryListBoxItemStyle}">
        <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
        <Setter Property="Tag"
                Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type views:WallpaperLibraryView}}}" />
        <Setter Property="ContextMenu" Value="{StaticResource LibraryProfileActionsMenu}" />
        <EventSetter Event="ContextMenuOpening" Handler="ProfileItem_ContextMenuOpening" />
      </Style>

      <Style x:Key="RecentLibraryListBoxItemStyle"
             TargetType="ListBoxItem"
             BasedOn="{StaticResource LibraryListBoxItemStyle}">
        <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
      </Style>

      <DataTemplate x:Key="ProfilePreviewTemplate">
        <Border Width="32"
                Height="32"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource WorkbenchRadius8}"
                ClipToBounds="True">
          <Grid>
            <Image Source="{Binding PreviewPath, Converter={StaticResource LibraryThumbnailConverter}}"
                   Stretch="UniformToFill"
                   IsHitTestVisible="False">
              <Image.Style>
                <Style TargetType="Image">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsImagePreviewAvailable}" Value="True">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Image.Style>
            </Image>

            <ui:SymbolIcon Symbol="Image24"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
              <ui:SymbolIcon.Style>
                <Style TargetType="ui:SymbolIcon">
                  <Setter Property="Visibility" Value="Visible" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsImagePreviewAvailable}" Value="True">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsVideo}" Value="True">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsMissing}" Value="True">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ui:SymbolIcon.Style>
            </ui:SymbolIcon>

            <ui:SymbolIcon Symbol="VideoClip24"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
              <ui:SymbolIcon.Style>
                <Style TargetType="ui:SymbolIcon">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <MultiDataTrigger>
                      <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsVideo}" Value="True" />
                        <Condition Binding="{Binding IsMissing}" Value="False" />
                      </MultiDataTrigger.Conditions>
                      <Setter Property="Visibility" Value="Visible" />
                    </MultiDataTrigger>
                  </Style.Triggers>
                </Style>
              </ui:SymbolIcon.Style>
            </ui:SymbolIcon>

            <ui:SymbolIcon Symbol="ErrorCircle24"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
              <ui:SymbolIcon.Style>
                <Style TargetType="ui:SymbolIcon">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMissing}" Value="True">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ui:SymbolIcon.Style>
            </ui:SymbolIcon>
          </Grid>
        </Border>
      </DataTemplate>

      <DataTemplate x:Key="ExpandedProfileTemplate">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="36" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="32" />
          </Grid.ColumnDefinitions>

          <ContentControl Content="{Binding}"
                          ContentTemplate="{StaticResource ProfilePreviewTemplate}"
                          IsHitTestVisible="False" />

          <StackPanel Grid.Column="1"
                      Margin="8,0,4,0"
                      VerticalAlignment="Center"
                      ToolTip="{Binding MediaDisplayName}">
            <TextBlock Text="{Binding Name}"
                       FontSize="{DynamicResource WorkbenchTypeBody}"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Margin="0,2,0,0"
                       Text="{Binding Subtitle}"
                       Style="{DynamicResource WorkbenchCaptionTextStyle}"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap" />
          </StackPanel>

          <ui:Button Grid.Column="2"
                     Width="32"
                     Height="32"
                     Padding="0"
                     Style="{DynamicResource WorkbenchIconButtonStyle}"
                     Tag="{Binding RelativeSource={RelativeSource AncestorType={x:Type views:WallpaperLibraryView}}}"
                     ContextMenu="{StaticResource LibraryProfileActionsMenu}"
                     ToolTip="{Binding ActionsAutomationName}"
                     AutomationProperties.Name="{Binding ActionsAutomationName}"
                     Click="ProfileActions_Click">
            <ui:SymbolIcon Symbol="MoreHorizontal24" />
          </ui:Button>
        </Grid>
      </DataTemplate>

      <DataTemplate x:Key="CompactProfileTemplate">
        <ContentControl HorizontalAlignment="Center"
                        Content="{Binding}"
                        ContentTemplate="{StaticResource ProfilePreviewTemplate}"
                        ToolTip="{Binding AutomationName}" />
      </DataTemplate>

      <DataTemplate x:Key="RecentPreviewTemplate">
        <Border Width="32"
                Height="32"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource WorkbenchRadius8}"
                ClipToBounds="True">
          <Grid>
            <Image x:Name="RecentThumbnail"
                   Source="{Binding Path, Converter={StaticResource LibraryThumbnailConverter}}"
                   Stretch="UniformToFill"
                   IsHitTestVisible="False" />
            <ui:SymbolIcon Symbol="Image24"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
              <ui:SymbolIcon.Style>
                <Style TargetType="ui:SymbolIcon">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <MultiDataTrigger>
                      <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding ElementName=RecentThumbnail, Path=Source}"
                                   Value="{x:Null}" />
                        <Condition Binding="{Binding Kind}" Value="Image" />
                        <Condition Binding="{Binding Exists}" Value="True" />
                      </MultiDataTrigger.Conditions>
                      <Setter Property="Visibility" Value="Visible" />
                    </MultiDataTrigger>
                  </Style.Triggers>
                </Style>
              </ui:SymbolIcon.Style>
            </ui:SymbolIcon>
            <ui:SymbolIcon Symbol="VideoClip24"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
              <ui:SymbolIcon.Style>
                <Style TargetType="ui:SymbolIcon">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <MultiDataTrigger>
                      <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Kind}" Value="Video" />
                        <Condition Binding="{Binding Exists}" Value="True" />
                      </MultiDataTrigger.Conditions>
                      <Setter Property="Visibility" Value="Visible" />
                    </MultiDataTrigger>
                  </Style.Triggers>
                </Style>
              </ui:SymbolIcon.Style>
            </ui:SymbolIcon>
            <ui:SymbolIcon Symbol="ErrorCircle24"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
              <ui:SymbolIcon.Style>
                <Style TargetType="ui:SymbolIcon">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Exists}" Value="False">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ui:SymbolIcon.Style>
            </ui:SymbolIcon>
          </Grid>
        </Border>
      </DataTemplate>

      <DataTemplate x:Key="ExpandedRecentTemplate">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="36" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="32" />
          </Grid.ColumnDefinitions>
          <ContentControl Content="{Binding}"
                          ContentTemplate="{StaticResource RecentPreviewTemplate}"
                          IsHitTestVisible="False" />
          <StackPanel Grid.Column="1"
                      Margin="8,0,4,0"
                      VerticalAlignment="Center"
                      ToolTip="{Binding DisplayName}">
            <TextBlock Text="{Binding DisplayName}"
                       FontSize="{DynamicResource WorkbenchTypeBody}"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Margin="0,2,0,0"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap">
              <TextBlock.Style>
                <Style TargetType="TextBlock"
                       BasedOn="{StaticResource WorkbenchCaptionTextStyle}">
                  <Setter Property="Text"
                          Value="{localization:Loc Media_Image, Fallback=Image}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Kind}" Value="Video">
                      <Setter Property="Text"
                              Value="{localization:Loc Media_Video, Fallback=Video}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Exists}" Value="False">
                      <Setter Property="Text"
                              Value="{localization:Loc Hint_MissingMediaCompact, Fallback=Missing}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
          <ui:Button Grid.Column="2"
                     Width="32"
                     Height="32"
                     Padding="0"
                     Style="{DynamicResource WorkbenchIconButtonStyle}"
                     Command="{Binding RemoveRecentCommand, ElementName=Root}"
                     CommandParameter="{Binding}"
                     ToolTip="{localization:Loc Action_Remove, Fallback=Remove}"
                     AutomationProperties.Name="{localization:Loc Action_Remove, Fallback=Remove}">
            <ui:SymbolIcon Symbol="Dismiss16" />
          </ui:Button>
        </Grid>
      </DataTemplate>

      <DataTemplate x:Key="CompactRecentTemplate">
        <ContentControl HorizontalAlignment="Center"
                        Content="{Binding}"
                        ContentTemplate="{StaticResource RecentPreviewTemplate}"
                        ToolTip="{Binding DisplayName}" />
      </DataTemplate>
    </ResourceDictionary>
  </UserControl.Resources>

  <Grid x:Name="RailLayout">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="RailDisplayStates">
        <VisualState x:Name="Expanded" />
        <VisualState x:Name="Compact" />
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <Border Style="{DynamicResource WorkbenchRailBorderStyle}">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    CanContentScroll="False"
                    PanningMode="VerticalOnly"
                    Focusable="False">
        <StackPanel Margin="4,8,4,12">
          <StackPanel x:Name="ExpandedProfilesHeader" Margin="8,4,8,8">
            <TextBlock Text="{localization:Loc Section_Profiles, Fallback='Wallpaper profiles'}"
                       Style="{DynamicResource WorkbenchSectionHeadingTextStyle}" />
            <TextBlock Margin="0,4,0,0"
                       Text="{localization:Loc Hint_ProfileStrip, Fallback='Choose the draft profile to preview and edit.'}"
                       Style="{DynamicResource WorkbenchCaptionTextStyle}" />
          </StackPanel>

          <Border x:Name="CompactProfilesHeader"
                  Height="32"
                  Margin="8,4,8,6"
                  ToolTip="{localization:Loc Section_Profiles, Fallback='Wallpaper profiles'}">
            <ui:SymbolIcon Symbol="Image24"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
          </Border>

          <ListBox x:Name="ProfileList"
                   ItemsSource="{Binding ProfileItemsSource, ElementName=Root}"
                   SelectedItem="{Binding SelectedProfile, ElementName=Root, Mode=TwoWay}"
                   IsEnabled="{Binding CanEditProfiles, ElementName=Root}"
                   ItemContainerStyle="{StaticResource ProfileLibraryListBoxItemStyle}"
                   SelectionMode="Single"
                   VirtualizingPanel.IsVirtualizing="False"
                   AutomationProperties.Name="{localization:Loc Section_Profiles, Fallback='Wallpaper profiles'}"
                   AutomationProperties.HelpText="{localization:Loc Hint_ProfileStrip, Fallback='Choose the draft profile to preview and edit.'}"
                   SelectionChanged="ProfileList_SelectionChanged">
            <ListBox.Style>
              <Style TargetType="ListBox"
                     BasedOn="{StaticResource WorkbenchListBoxStyle}">
                <Setter Property="ItemTemplate"
                        Value="{StaticResource ExpandedProfileTemplate}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsCompact, ElementName=Root}" Value="True">
                    <Setter Property="ItemTemplate"
                            Value="{StaticResource CompactProfileTemplate}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ListBox.Style>
          </ListBox>

          <ui:Button x:Name="ExpandedCreateProfileButton"
                     Margin="4,6,4,0"
                     Style="{DynamicResource WorkbenchRailActionButtonStyle}"
                     Command="{Binding CreateProfileCommand, ElementName=Root}"
                     IsEnabled="{Binding CanEditProfiles, ElementName=Root}"
                     AutomationProperties.Name="{localization:Loc Action_NewProfile, Fallback='New profile'}">
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="Add16" VerticalAlignment="Center" />
              <TextBlock Margin="8,0,0,0"
                         Text="{localization:Loc Action_NewProfile, Fallback='New profile'}"
                         VerticalAlignment="Center" />
            </StackPanel>
          </ui:Button>

          <ui:Button x:Name="CompactCreateProfileButton"
                     Width="40"
                     Height="40"
                     Margin="4,6,4,0"
                     Padding="0"
                     Style="{DynamicResource WorkbenchIconButtonStyle}"
                     Command="{Binding CreateProfileCommand, ElementName=Root}"
                     IsEnabled="{Binding CanEditProfiles, ElementName=Root}"
                     ToolTip="{localization:Loc Action_NewProfile, Fallback='New profile'}"
                     AutomationProperties.Name="{localization:Loc Action_NewProfile, Fallback='New profile'}">
            <ui:SymbolIcon Symbol="Add16" />
          </ui:Button>

          <Border Margin="8,12" Style="{DynamicResource WorkbenchDividerStyle}" />

          <ui:Button x:Name="ExpandedChooseMediaButton"
                     Margin="4,0"
                     Style="{DynamicResource WorkbenchRailActionButtonStyle}"
                     IsEnabled="{Binding CanChooseMedia, ElementName=Root}"
                     AutomationProperties.Name="{localization:Loc Action_SelectMedia, Fallback='Choose media'}"
                     Click="ChooseLocalMedia_Click">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <ui:SymbolIcon Symbol="FolderOpen24"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <TextBlock Text="{localization:Loc Action_SelectMedia, Fallback='Choose media'}"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Margin="0,2,0,0"
                           Text="{localization:Loc Hint_SupportedFormats, Fallback='PNG, JPEG, WebP, MP4, or WebM'}"
                           Style="{DynamicResource WorkbenchCaptionTextStyle}"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap" />
              </StackPanel>
            </Grid>
          </ui:Button>

          <ui:Button x:Name="CompactChooseMediaButton"
                     Width="40"
                     Height="40"
                     Margin="4,0"
                     Padding="0"
                     Style="{DynamicResource WorkbenchIconButtonStyle}"
                     IsEnabled="{Binding CanChooseMedia, ElementName=Root}"
                     ToolTip="{localization:Loc Action_SelectMedia, Fallback='Choose media'}"
                     AutomationProperties.Name="{localization:Loc Action_SelectMedia, Fallback='Choose media'}"
                     Click="ChooseLocalMedia_Click">
            <ui:SymbolIcon Symbol="FolderOpen24" />
          </ui:Button>

          <Border Margin="8,12" Style="{DynamicResource WorkbenchDividerStyle}" />

          <Grid x:Name="ExpandedRecentHeader" Margin="8,0,4,6">
            <TextBlock Text="{localization:Loc Section_RecentMedia, Fallback='Recent media'}"
                       Style="{DynamicResource WorkbenchSectionHeadingTextStyle}"
                       VerticalAlignment="Center" />
            <ui:Button MinWidth="32"
                       MinHeight="32"
                       Padding="6,2"
                       HorizontalAlignment="Right"
                       Style="{DynamicResource WorkbenchIconButtonStyle}"
                       Command="{Binding ClearRecentsCommand, ElementName=Root}"
                       Content="{localization:Loc Action_ClearRecent, Fallback='Clear recent'}"
                       FontSize="{DynamicResource WorkbenchTypeCaption}"
                       AutomationProperties.Name="{localization:Loc Action_ClearRecent, Fallback='Clear recent'}" />
          </Grid>

          <Border x:Name="CompactRecentHeader"
                  Height="32"
                  Margin="8,0,8,6"
                  ToolTip="{localization:Loc Section_RecentMedia, Fallback='Recent media'}">
            <ui:SymbolIcon Symbol="History16"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
          </Border>

          <TextBlock Margin="8,4,8,8"
                     Text="{localization:Loc Hint_NoRecentMedia, Fallback='Your recently used media will appear here.'}">
            <TextBlock.Style>
              <Style TargetType="TextBlock"
                     BasedOn="{StaticResource WorkbenchCaptionTextStyle}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                      <Condition Binding="{Binding IsCompact, ElementName=Root}" Value="False" />
                      <Condition Binding="{Binding RecentItemsSource.Count, ElementName=Root}" Value="0" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                  </MultiDataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>

          <ListBox x:Name="RecentList"
                   ItemsSource="{Binding RecentItemsSource, ElementName=Root}"
                   SelectedItem="{Binding SelectedRecentMedia, ElementName=Root, Mode=TwoWay}"
                   IsEnabled="{Binding CanChooseMedia, ElementName=Root}"
                   ItemContainerStyle="{StaticResource RecentLibraryListBoxItemStyle}"
                   SelectionMode="Single"
                   VirtualizingPanel.IsVirtualizing="False"
                   AutomationProperties.Name="{localization:Loc Section_RecentMedia, Fallback='Recent media'}"
                   SelectionChanged="RecentList_SelectionChanged"
                   MouseDoubleClick="RecentList_MouseDoubleClick"
                   PreviewKeyDown="RecentList_PreviewKeyDown">
            <ListBox.Style>
              <Style TargetType="ListBox"
                     BasedOn="{StaticResource WorkbenchListBoxStyle}">
                <Setter Property="ItemTemplate"
                        Value="{StaticResource ExpandedRecentTemplate}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsCompact, ElementName=Root}" Value="True">
                    <Setter Property="ItemTemplate"
                            Value="{StaticResource CompactRecentTemplate}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ListBox.Style>
          </ListBox>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
