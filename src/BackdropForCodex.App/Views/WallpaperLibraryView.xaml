<UserControl x:Class="BackdropForCodex.App.Views.WallpaperLibraryView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localization="clr-namespace:BackdropForCodex.App.Services.Localization"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:BackdropForCodex.App.Views"
             Width="224"
             MinWidth="56"
             Focusable="False"
             Style="{DynamicResource WorkbenchRootStyle}">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/BackdropForCodex;component/Themes/WorkbenchTheme.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <Style x:Key="WallpaperEngineRailStatusTextStyle"
             TargetType="TextBlock"
             BasedOn="{StaticResource WorkbenchCaptionTextStyle}">
        <Setter Property="Text"
                Value="{localization:Loc Source_NotLoaded, Fallback='Not loaded'}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding WallpaperEngineAvailability, ElementName=Root}"
                       Value="Ready">
            <Setter Property="Text"
                    Value="{localization:Loc Source_Ready, Fallback=Ready}" />
          </DataTrigger>
          <DataTrigger Binding="{Binding WallpaperEngineAvailability, ElementName=Root}"
                       Value="Refreshing">
            <Setter Property="Text"
                    Value="{localization:Loc Source_Refreshing, Fallback=Refreshing}" />
          </DataTrigger>
          <DataTrigger Binding="{Binding WallpaperEngineAvailability, ElementName=Root}"
                       Value="NotInstalled">
            <Setter Property="Text"
                    Value="{localization:Loc Source_NotInstalled, Fallback='Not installed'}" />
          </DataTrigger>
          <DataTrigger Binding="{Binding WallpaperEngineAvailability, ElementName=Root}"
                       Value="InstallationSelectionRequired">
            <Setter Property="Text"
                    Value="{localization:Loc Source_InstallationSelectionRequiredShort, Fallback='Choose installation'}" />
          </DataTrigger>
          <DataTrigger Binding="{Binding WallpaperEngineAvailability, ElementName=Root}"
                       Value="InstallationSelectionInvalid">
            <Setter Property="Text"
                    Value="{localization:Loc Source_InstallationSelectionInvalidShort, Fallback='Installation invalid'}" />
          </DataTrigger>
          <DataTrigger Binding="{Binding WallpaperEngineAvailability, ElementName=Root}"
                       Value="InstallationSelectionFailed">
            <Setter Property="Text"
                    Value="{localization:Loc Source_InstallationSelectionFailedShort, Fallback='Choice not saved'}" />
          </DataTrigger>
          <DataTrigger Binding="{Binding WallpaperEngineAvailability, ElementName=Root}"
                       Value="Stale">
            <Setter Property="Text"
                    Value="{localization:Loc Source_Stale, Fallback='Refresh required'}" />
          </DataTrigger>
          <DataTrigger Binding="{Binding WallpaperEngineAvailability, ElementName=Root}"
                       Value="RendererUnavailable">
            <Setter Property="Text"
                Value="{localization:Loc Source_RendererUnavailable, Fallback='Live playback unavailable'}" />
          </DataTrigger>
          <MultiDataTrigger>
            <MultiDataTrigger.Conditions>
              <Condition Binding="{Binding HasSourceDiscoveryFailures, ElementName=Root}"
                         Value="True" />
              <Condition Binding="{Binding WallpaperEngineAvailability, ElementName=Root}"
                         Value="Ready" />
            </MultiDataTrigger.Conditions>
            <Setter Property="Text"
                    Value="{localization:Loc Source_Stale, Fallback='Refresh required'}" />
          </MultiDataTrigger>
        </Style.Triggers>
      </Style>

      <Style x:Key="WallpaperEngineStatusDotStyle" TargetType="Ellipse">
        <Setter Property="Fill" Value="{DynamicResource TextFillColorDisabledBrush}" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding WallpaperEngineAvailability, ElementName=Root}"
                       Value="Ready">
            <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
          </DataTrigger>
          <DataTrigger Binding="{Binding IsWallpaperEngineRefreshing, ElementName=Root}"
                       Value="True">
            <Setter Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}" />
          </DataTrigger>
          <DataTrigger Binding="{Binding HasSourceDiscoveryFailures, ElementName=Root}"
                       Value="True">
            <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
          </DataTrigger>
          <DataTrigger Binding="{Binding WallpaperEngineAvailability, ElementName=Root}"
                       Value="NotInstalled">
            <Setter Property="Fill" Value="{DynamicResource TextFillColorDisabledBrush}" />
          </DataTrigger>
          <DataTrigger Binding="{Binding WallpaperEngineAvailability, ElementName=Root}"
                       Value="RendererUnavailable">
            <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>

  <Grid x:Name="RailLayout">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="RailDisplayStates">
        <VisualState x:Name="Expanded" />
        <VisualState x:Name="Compact" />
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <Border Style="{DynamicResource WorkbenchRailBorderStyle}">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    CanContentScroll="False"
                    PanningMode="VerticalOnly"
                    Focusable="False">
        <StackPanel Margin="4,8,4,16">
          <views:WallpaperProfilesSection x:Name="ProfilesSection"
                                          ProfileItemsSource="{Binding ProfileItemsSource, ElementName=Root}"
                                          SelectedProfile="{Binding SelectedProfile, ElementName=Root, Mode=TwoWay}"
                                          CreateProfileCommand="{Binding CreateProfileCommand, ElementName=Root}"
                                          DuplicateProfileCommand="{Binding DuplicateProfileCommand, ElementName=Root}"
                                          RenameProfileCommand="{Binding RenameProfileCommand, ElementName=Root}"
                                          DeleteProfileCommand="{Binding DeleteProfileCommand, ElementName=Root}"
                                          CanEditProfiles="{Binding CanEditProfiles, ElementName=Root}"
                                          IsCompact="{Binding IsCompact, ElementName=Root}" />

          <Border x:Name="ProfilesGroupDivider"
                  Style="{DynamicResource WorkbenchRailDividerStyle}" />

          <Grid x:Name="ExpandedSourcesHeader" Margin="8,0,4,8">
            <TextBlock Text="{localization:Loc Section_Sources, Fallback=Sources}"
                       Style="{DynamicResource WorkbenchRailSectionHeadingTextStyle}" />
            <ui:Button x:Name="ExpandedWallpaperEngineRefreshButton"
                       Width="28"
                       Height="28"
                       Padding="0"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Style="{DynamicResource WorkbenchIconButtonStyle}"
                       Command="{Binding RefreshSourcesCommand, ElementName=Root}"
                       ToolTip="{localization:Loc Action_Refresh, Fallback=Refresh}"
                       AutomationProperties.Name="{localization:Loc Action_Refresh, Fallback=Refresh}">
              <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="15" />
            </ui:Button>
          </Grid>

          <ui:Button x:Name="ExpandedChooseMediaButton"
                     Margin="{DynamicResource WorkbenchRailGroupInset}"
                     Style="{DynamicResource WorkbenchRailActionButtonStyle}"
                     IsEnabled="{Binding CanChooseMedia, ElementName=Root}"
                     ToolTip="{localization:Loc Hint_SupportedFormats, Fallback='PNG, JPEG, WebP, MP4, or WebM'}"
                     AutomationProperties.Name="{localization:Loc Action_SelectMedia, Fallback='Choose media'}"
                     AutomationProperties.HelpText="{localization:Loc Hint_SupportedFormats, Fallback='PNG, JPEG, WebP, MP4, or WebM'}"
                     Click="ChooseLocalMedia_Click">
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="FolderOpen24" VerticalAlignment="Center" />
              <TextBlock Margin="8,0,0,0"
                         Text="{localization:Loc Action_SelectMedia, Fallback='Choose media'}"
                         VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </ui:Button>

          <ui:Button x:Name="CompactChooseMediaButton"
                     Width="40"
                     Height="40"
                     Margin="4,8,4,0"
                     Padding="0"
                     Visibility="Collapsed"
                     Style="{DynamicResource WorkbenchIconButtonStyle}"
                     IsEnabled="{Binding CanChooseMedia, ElementName=Root}"
                     ToolTip="{localization:Loc Action_SelectMedia, Fallback='Choose media'}"
                     AutomationProperties.Name="{localization:Loc Action_SelectMedia, Fallback='Choose media'}"
                     AutomationProperties.HelpText="{localization:Loc Hint_SupportedFormats, Fallback='PNG, JPEG, WebP, MP4, or WebM'}"
                     Click="ChooseLocalMedia_Click">
            <ui:SymbolIcon Symbol="FolderOpen24" />
          </ui:Button>

          <Grid Margin="4,8,4,0">
            <ui:Button x:Name="ExpandedWallpaperEngineButton"
                       MinHeight="52"
                       Padding="10,6"
                       Style="{DynamicResource WorkbenchRailActionButtonStyle}"
                  ToolTip="{localization:Loc Source_LibraryHint, Fallback='Browse installed Wallpaper Engine projects. Scene and Web require Wallpaper Engine to be running and may play sound through it.'}"
                       AutomationProperties.Name="{localization:Loc Source_LibraryTitle, Fallback='Wallpaper Engine'}"
                  AutomationProperties.HelpText="{localization:Loc Source_LibraryHint, Fallback='Browse installed Wallpaper Engine projects. Scene and Web require Wallpaper Engine to be running and may play sound through it.'}"
                       Click="WallpaperEngineLibrary_Click">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="32" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="32" Height="32">
                  <Border Background="{DynamicResource ControlFillColorTertiaryBrush}"
                          CornerRadius="{DynamicResource WorkbenchRadius8}">
                    <ui:SymbolIcon Symbol="Library24"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                  </Border>
                  <Ellipse Width="8"
                           Height="8"
                           Margin="0,0,-2,-2"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Bottom"
                           Stroke="{DynamicResource LayerFillColorDefaultBrush}"
                           StrokeThickness="2"
                           Style="{StaticResource WallpaperEngineStatusDotStyle}" />
                </Grid>
                <StackPanel Grid.Column="1"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center">
                  <!-- Keep availability on its own full-width row for localization. -->
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{localization:Loc Source_LibraryTitle, Fallback='Wallpaper Engine'}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <!-- Room only for the number, so the unit lives in the tooltip. -->
                    <TextBlock Grid.Column="1"
                               Margin="6,0,0,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource WorkbenchCaptionTextStyle}"
                               TextWrapping="NoWrap"
                               Text="{Binding WallpaperEngineProjectCount, ElementName=Root}">
                      <TextBlock.ToolTip>
                        <TextBlock>
                          <Run Text="{Binding WallpaperEngineProjectCount, ElementName=Root, Mode=OneWay}" />
                          <Run Text="{localization:Loc Source_ProjectCountSuffix, Fallback=' projects'}" />
                        </TextBlock>
                      </TextBlock.ToolTip>
                    </TextBlock>
                  </Grid>
                  <TextBlock Margin="0,2,0,0"
                             Style="{StaticResource WallpaperEngineRailStatusTextStyle}" />
                </StackPanel>
              </Grid>
            </ui:Button>
          </Grid>

          <ui:Button x:Name="CompactWallpaperEngineButton"
                     Width="40"
                     Height="40"
                     Margin="4,8,4,0"
                     Padding="0"
                     Visibility="Collapsed"
                     Style="{DynamicResource WorkbenchIconButtonStyle}"
                     ToolTip="{localization:Loc Source_LibraryTitle, Fallback='Wallpaper Engine'}"
                     AutomationProperties.Name="{localization:Loc Source_LibraryTitle, Fallback='Wallpaper Engine'}"
                     Click="WallpaperEngineLibrary_Click">
            <Grid Width="24" Height="24">
              <ui:SymbolIcon Symbol="Library24" />
              <Ellipse Width="8"
                       Height="8"
                       Margin="0,0,-3,-3"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"
                       Stroke="{DynamicResource LayerFillColorDefaultBrush}"
                       StrokeThickness="2"
                       Style="{StaticResource WallpaperEngineStatusDotStyle}" />
            </Grid>
          </ui:Button>

          <Border x:Name="SourcesGroupDivider"
                  Style="{DynamicResource WorkbenchRailDividerStyle}" />

          <views:WallpaperRecentsSection x:Name="RecentsSection"
                                         RecentItemsSource="{Binding RecentItemsSource, ElementName=Root}"
                                         SelectedRecentMedia="{Binding SelectedRecentMedia, ElementName=Root, Mode=TwoWay}"
                                         OpenRecentMediaCommand="{Binding OpenRecentMediaCommand, ElementName=Root}"
                                         RemoveRecentCommand="{Binding RemoveRecentCommand, ElementName=Root}"
                                         ClearRecentsCommand="{Binding ClearRecentsCommand, ElementName=Root}"
                                         CanChooseMedia="{Binding CanChooseMedia, ElementName=Root}"
                                         IsCompact="{Binding IsCompact, ElementName=Root}"
                                         RecentMediaInvoked="RecentsSection_RecentMediaInvoked" />
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
