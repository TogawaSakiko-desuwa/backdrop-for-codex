<UserControl x:Class="BackdropForCodex.App.Views.WallpaperLibraryView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localization="clr-namespace:BackdropForCodex.App.Services.Localization"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:BackdropForCodex.App.Views"
             Width="224"
             MinWidth="56"
             Focusable="False"
             Style="{DynamicResource WorkbenchRootStyle}">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/BackdropForCodex;component/Themes/WorkbenchTheme.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <Grid x:Name="RailLayout">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="RailDisplayStates">
        <VisualState x:Name="Expanded" />
        <VisualState x:Name="Compact" />
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <Border Style="{DynamicResource WorkbenchRailBorderStyle}">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    CanContentScroll="False"
                    PanningMode="VerticalOnly"
                    Focusable="False">
        <StackPanel Margin="4,8,4,16">
          <views:WallpaperProfilesSection x:Name="ProfilesSection"
                                          ProfileItemsSource="{Binding ProfileItemsSource, ElementName=Root}"
                                          SelectedProfile="{Binding SelectedProfile, ElementName=Root, Mode=TwoWay}"
                                          CreateProfileCommand="{Binding CreateProfileCommand, ElementName=Root}"
                                          DuplicateProfileCommand="{Binding DuplicateProfileCommand, ElementName=Root}"
                                          RenameProfileCommand="{Binding RenameProfileCommand, ElementName=Root}"
                                          DeleteProfileCommand="{Binding DeleteProfileCommand, ElementName=Root}"
                                          CanEditProfiles="{Binding CanEditProfiles, ElementName=Root}"
                                          IsCompact="{Binding IsCompact, ElementName=Root}" />

          <ui:Button x:Name="ExpandedChooseMediaButton"
                     Margin="4,8,4,0"
                     Style="{DynamicResource WorkbenchRailActionButtonStyle}"
                     IsEnabled="{Binding CanChooseMedia, ElementName=Root}"
                     ToolTip="{localization:Loc Hint_SupportedFormats, Fallback='PNG, JPEG, WebP, MP4, or WebM'}"
                     AutomationProperties.Name="{localization:Loc Action_SelectMedia, Fallback='Choose media'}"
                     AutomationProperties.HelpText="{localization:Loc Hint_SupportedFormats, Fallback='PNG, JPEG, WebP, MP4, or WebM'}"
                     Click="ChooseLocalMedia_Click">
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="FolderOpen24" VerticalAlignment="Center" />
              <TextBlock Margin="8,0,0,0"
                         Text="{localization:Loc Action_SelectMedia, Fallback='Choose media'}"
                         VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </ui:Button>

          <ui:Button x:Name="CompactChooseMediaButton"
                     Width="40"
                     Height="40"
                     Margin="4,8,4,0"
                     Padding="0"
                     Visibility="Collapsed"
                     Style="{DynamicResource WorkbenchIconButtonStyle}"
                     IsEnabled="{Binding CanChooseMedia, ElementName=Root}"
                     ToolTip="{localization:Loc Action_SelectMedia, Fallback='Choose media'}"
                     AutomationProperties.Name="{localization:Loc Action_SelectMedia, Fallback='Choose media'}"
                     AutomationProperties.HelpText="{localization:Loc Hint_SupportedFormats, Fallback='PNG, JPEG, WebP, MP4, or WebM'}"
                     Click="ChooseLocalMedia_Click">
            <ui:SymbolIcon Symbol="FolderOpen24" />
          </ui:Button>

          <views:WallpaperSourcesSection x:Name="SourcesSection"
                                         SourceItemsSource="{Binding SourceItemsSource, ElementName=Root}"
                                         SelectedSource="{Binding SelectedSource, ElementName=Root, Mode=TwoWay}"
                                         HasDiscoveryFailures="{Binding HasSourceDiscoveryFailures, ElementName=Root}"
                                         RefreshSourcesCommand="{Binding RefreshSourcesCommand, ElementName=Root}"
                                         CanChooseSources="{Binding CanChooseMedia, ElementName=Root}"
                                         IsCompact="{Binding IsCompact, ElementName=Root}"
                                         SourceInvoked="SourcesSection_SourceInvoked" />

          <views:WallpaperRecentsSection x:Name="RecentsSection"
                                         RecentItemsSource="{Binding RecentItemsSource, ElementName=Root}"
                                         SelectedRecentMedia="{Binding SelectedRecentMedia, ElementName=Root, Mode=TwoWay}"
                                         OpenRecentMediaCommand="{Binding OpenRecentMediaCommand, ElementName=Root}"
                                         RemoveRecentCommand="{Binding RemoveRecentCommand, ElementName=Root}"
                                         ClearRecentsCommand="{Binding ClearRecentsCommand, ElementName=Root}"
                                         CanChooseMedia="{Binding CanChooseMedia, ElementName=Root}"
                                         IsCompact="{Binding IsCompact, ElementName=Root}"
                                         RecentMediaInvoked="RecentsSection_RecentMediaInvoked" />
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
