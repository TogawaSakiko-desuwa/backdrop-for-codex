<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <!-- Precision-workbench scale. Values stay discrete so adjacent panes share one rhythm. -->
  <sys:Double x:Key="WorkbenchSpace4">4</sys:Double>
  <sys:Double x:Key="WorkbenchSpace8">8</sys:Double>
  <sys:Double x:Key="WorkbenchSpace12">12</sys:Double>
  <sys:Double x:Key="WorkbenchSpace16">16</sys:Double>
  <sys:Double x:Key="WorkbenchSpace24">24</sys:Double>
  <sys:Double x:Key="WorkbenchSpace32">32</sys:Double>

  <Thickness x:Key="WorkbenchInset4">4</Thickness>
  <Thickness x:Key="WorkbenchInset8">8</Thickness>
  <Thickness x:Key="WorkbenchInset12">12</Thickness>
  <Thickness x:Key="WorkbenchInset16">16</Thickness>
  <Thickness x:Key="WorkbenchInset24">24</Thickness>
  <Thickness x:Key="WorkbenchInset32">32</Thickness>

  <CornerRadius x:Key="WorkbenchRadius8">8</CornerRadius>
  <CornerRadius x:Key="WorkbenchRadius12">12</CornerRadius>
  <CornerRadius x:Key="WorkbenchRadius16">16</CornerRadius>

  <sys:Double x:Key="WorkbenchTypeDisplay">24</sys:Double>
  <sys:Double x:Key="WorkbenchTypeSection">16</sys:Double>
  <sys:Double x:Key="WorkbenchTypeBody">14</sys:Double>
  <sys:Double x:Key="WorkbenchTypeCaption">12</sys:Double>
  <sys:Double x:Key="WorkbenchTargetMinimum">32</sys:Double>
  <sys:Double x:Key="WorkbenchPrimaryTargetMinimum">36</sys:Double>

  <FontFamily x:Key="WorkbenchDisplayFontFamily">Segoe UI Variable Display, Segoe UI</FontFamily>
  <FontFamily x:Key="WorkbenchTextFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>

  <!-- System and WPF UI dynamic resources own light, dark, accent, and high-contrast colors. -->
  <Style x:Key="WorkbenchFocusVisualStyle" TargetType="Control">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Margin="-3"
                  BorderBrush="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"
                  BorderThickness="2"
                  CornerRadius="{DynamicResource WorkbenchRadius8}"
                  SnapsToDevicePixels="True" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="WorkbenchRootStyle" TargetType="UserControl">
    <Setter Property="FontFamily" Value="{DynamicResource WorkbenchTextFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource WorkbenchTypeBody}" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <Style x:Key="WorkbenchRailBorderStyle" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource LayerFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <Style x:Key="WorkbenchInspectorBorderStyle" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource LayerFillColorAltBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1,0,0,0" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <Style x:Key="WorkbenchCalibrationSurfaceStyle" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorBaseBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource WorkbenchRadius12}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <Style x:Key="WorkbenchDividerStyle" TargetType="Border">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <Style x:Key="WorkbenchTitleTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource WorkbenchDisplayFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource WorkbenchTypeDisplay}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style x:Key="WorkbenchSectionHeadingTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource WorkbenchTypeSection}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style x:Key="WorkbenchBodyTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource WorkbenchTypeBody}" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="WorkbenchCaptionTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource WorkbenchTypeCaption}" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="WorkbenchIconButtonStyle" TargetType="ui:Button">
    <Setter Property="MinWidth" Value="{DynamicResource WorkbenchTargetMinimum}" />
    <Setter Property="MinHeight" Value="{DynamicResource WorkbenchTargetMinimum}" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="Appearance" Value="Transparent" />
    <Setter Property="FocusVisualStyle" Value="{DynamicResource WorkbenchFocusVisualStyle}" />
  </Style>

  <Style x:Key="WorkbenchRailActionButtonStyle" TargetType="ui:Button">
    <Setter Property="MinWidth" Value="{DynamicResource WorkbenchTargetMinimum}" />
    <Setter Property="MinHeight" Value="{DynamicResource WorkbenchTargetMinimum}" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Appearance" Value="Secondary" />
    <Setter Property="FocusVisualStyle" Value="{DynamicResource WorkbenchFocusVisualStyle}" />
  </Style>

  <Style x:Key="WorkbenchPrimaryActionButtonStyle" TargetType="ui:Button">
    <Setter Property="MinHeight" Value="{DynamicResource WorkbenchPrimaryTargetMinimum}" />
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="Appearance" Value="Primary" />
    <Setter Property="FocusVisualStyle" Value="{DynamicResource WorkbenchFocusVisualStyle}" />
  </Style>

  <Style x:Key="WorkbenchListBoxStyle" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
    <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Contained" />
    <Setter Property="KeyboardNavigation.TabNavigation" Value="Once" />
  </Style>
</ResourceDictionary>
