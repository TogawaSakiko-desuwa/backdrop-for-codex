<Application x:Class="BackdropForCodex.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ui:ThemesDictionary Theme="Light" />
        <ui:ControlsDictionary />
        <ResourceDictionary Source="/BackdropForCodex;component/Themes/WorkbenchTheme.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- A layer sitting behind a window: the backdrop. Monochrome so it reads at 16 px. -->
      <DrawingImage x:Key="AppIconImage">
        <DrawingImage.Drawing>
          <DrawingGroup>
            <GeometryDrawing Brush="#1E2733">
              <GeometryDrawing.Geometry>
                <RectangleGeometry Rect="0,0,32,32" RadiusX="8" RadiusY="8" />
              </GeometryDrawing.Geometry>
            </GeometryDrawing>
            <GeometryDrawing Brush="#4C8DFF">
              <GeometryDrawing.Geometry>
                <RectangleGeometry Rect="6,6,15,13" RadiusX="3.5" RadiusY="3.5" />
              </GeometryDrawing.Geometry>
            </GeometryDrawing>
            <GeometryDrawing Brush="#331E2733">
              <GeometryDrawing.Geometry>
                <RectangleGeometry Rect="11,12,15,13" RadiusX="3.5" RadiusY="3.5" />
              </GeometryDrawing.Geometry>
              <GeometryDrawing.Pen>
                <Pen Brush="#F4F7FB" Thickness="2" LineJoin="Round" />
              </GeometryDrawing.Pen>
            </GeometryDrawing>
          </DrawingGroup>
        </DrawingImage.Drawing>
      </DrawingImage>

      <Style x:Key="SectionHeadingStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      </Style>

      <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>

      <Style x:Key="InspectorLabelStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
