<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>BackdropForCodex.Core</RootNamespace>
    <AssemblyName>BackdropForCodex.Core</AssemblyName>
    <AssemblyTitle>Backdrop for Codex Core</AssemblyTitle>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="PuppeteerSharp" />
    <PackageReference Include="Vortice.MediaFoundation" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Injection/Templates/Install.js"
                      LogicalName="BackdropForCodex.Core.Injection.Templates.Install.js" />
    <EmbeddedResource Include="Injection/Templates/Wallpaper.css"
                      LogicalName="BackdropForCodex.Core.Injection.Templates.Wallpaper.css" />
  </ItemGroup>
</Project>
